unit Granular.Hints;

{ ERZEUGT von Tools/make_hints.py aus der Reglertabelle der Hilfe - nicht von Hand aendern.
  Tooltip-Texte je Regler (ueber den Parameternamen) und je Knopfbeschriftung. }

interface

{ Tooltip eines Reglers (Index wie in Granular.Params),  = keiner }
function ParamHint(Index: Integer): string;
{ Tooltip zu einer Knopf-/Schalterbeschriftung,  = keiner }
function CaptionHint(const Caption: string): string;

