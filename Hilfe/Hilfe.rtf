\pard\intbl{\cf2 LFO 1 bis 8: Rate, Form, Sync}\cell\pard\intbl{langsame Schwingung (Sinus, Dreieck, S\'e4ge, Rechteck, Zufall, Frei); Sync = im Takt des Hosts. Klick auf die Grafik \'f6ffnet die freie Form. Umschalter unten rechts: LFO 1-4 / LFO 5-8 (in Klammern: benutzte LFOs 5-8; unbenutzte kosten keine Rechenzeit).}\cell\pard\intbl{\cf4 ja (freie Form: nein; LFO1..LFO8 Rate, Form, Sync)}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Freie Form: Klaviatur, Gl\'e4ttung}\cell\pard\intbl{im Fenster der freien Form (Klick auf die LFO-Grafik): im Modus Halbt\'f6ne zeigt links eine Klaviatur, welche Note jede Stufe spielt (Bezugston = die Taste, die du spielst; jedes C mit Oktave), die Stufen tragen den Notennamen. Gl\'e4ttung 0-100 %: 0 % = harte Stufen (jeder Ton steht), wenig = kurzes Gleiten von Ton zu Ton, 100 % = runde Kurve; die helle Linie zeigt den echten Verlauf. Leiste \'84Gleiten\'93 unter den Stufen: Klick l\'e4sst eine einzelne Stufe vom vorigen Ton her\'fcbergleiten (wie Slide am Step-Sequencer), die anderen springen weiter hart. Pause: Rechtsklick auf eine Stufe (Ziehen f\'fcr mehrere) schaltet sie auf Pause - schraffiert mit \'84Pause\'93, dort schweigt der Klang kurz und klickfrei, Echo und Hall klingen aus (unabh\'e4ngig vom Trance-Gate). Wird mit dem Preset gespeichert.}\cell\pard\intbl{\cf5 nein}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Einmal}\cell\pard\intbl{der LFO l\'e4uft nur einen Durchgang und bleibt dann stehen (Melodien, Effekt-Einsatz).}\cell\pard\intbl{\cf4 ja (LFO1..LFO8 Einmal)}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Neustart}\cell\pard\intbl{frei, Note an, Note aus, an + aus, Ende Partner-LFO (Einmal), Sidechain-Trigger, SC-Ton > Schwelle, Schwellen-Tor \'f6ffnet, Ruhe, Ausgang > Schwelle.}\cell\pard\intbl{\cf4 ja (LFO1..LFO8 Trigger)}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Partner}\cell\pard\intbl{welcher LFO mit seinem Einmal-Ende das Ereignis "Ende Partner-LFO (Einmal)" ausl\'f6st - f\'fcr Start und Stopp. Vorgabe: 1 und 2 bzw. 3 und 4 gegenseitig; beliebige Ketten m\'f6glich (z.B. 1 -> 2 -> 3 -> 4). Der Partner muss auf "Einmal" stehen. Nur aktiv, wenn Start oder Stopp dieses Ereignis nutzt.}\cell\pard\intbl{\cf4 ja (LFO1..LFO8 Partner)}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Stopp}\cell\pard\intbl{Aus-Trigger: das Ereignis (Note an, Note aus, Ende Partner-LFO, Sidechain-Trigger, SC-Ton, Schwellen-Tor, Ruhe, Ausgang > Schwelle) h\'e4lt den LFO an - keine Modulation, bis sein Start-Ereignis ihn wieder startet. "nie" = l\'e4uft weiter. Wirkt nur mit Start-Ereignis (nicht bei "frei"); mit Stopp wartet der LFO auch anfangs auf seinen ersten Start. Bei LFOs je Note h\'e4lt "Note aus" nur die losgelassene Note an. Verz\'f6gerung wie beim Start (Reiter Timing / H\'fcllk.). "nach Zeit": der LFO h\'e4lt nach einer festen Laufzeit ab seinem Start an - in ms oder als Notenwert (2/1, 1/1, 1/2, 1/4, 1/4T ...; ein Notenwert gilt vor den ms).}\cell\pard\intbl{\cf4 ja (LFO1..LFO8 Stopp, Stoppzeit, Stoppzeit Takt)}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Ausgang > Schwelle}\cell\pard\intbl{Trigger auf den eigenen Ausgangspegel: \'fcberschreitet er die Schwelle, startet ein LFO mit diesem Neustart. Ein so gestarteter LFO l\'f6st sich nicht selbst erneut aus, solange er l\'e4uft (keine R\'fcckkopplung).}\cell\pard\intbl{\cf4 ja (Ausgangs-Schwelle)}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Sidechain-Trigger: Pegel / Ton}\cell\pard\intbl{wann der Trigger ausl\'f6st: Pegel \'fcber der Schwelle und/oder Ton \'fcber der Note; beide angehakt = beides n\'f6tig.}\cell\pard\intbl{\cf4 ja (nicht modulierbar; SC-Trig Pegel, SC-Schwelle, SC-Trig Ton, SC-Ton-Schwelle)}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Auto-Pitch}\cell\pard\intbl{die Tonh\'f6he kommt vom Sidechain (gesungener Ton) statt von der Taste - stufenlos oder in Halbt\'f6nen.}\cell\pard\intbl{\cf4 ja (Auto-Pitch)}\cell\row
