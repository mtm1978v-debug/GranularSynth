{\cf3\b\fs22 Reiter Samples\par}
\trowd\trgaph90\trleft0\clcbpat6\cellx2500\clcbpat6\cellx7300\clcbpat6\cellx10200
\pard\intbl{\b \cf2 Regler / Knopf}\cell\pard\intbl{\b Was er bewirkt}\cell\pard\intbl{\b VST-Parameter}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Zonen 1-3}\cell\pard\intbl{weitere Samples je Tastenbereich (ab Starttaste); Laden, Leeren, Datei auf die Zeile ziehen.}\cell\pard\intbl{\cf5 nein}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Aufnahme}\cell\pard\intbl{nimmt den Sidechain-Eingang auf (bis 60 s) und l\'e4dt ihn als Hauptsample (WAV in Eigene Toene).}\cell\pard\intbl{\cf5 nein}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Feedback-Resampling: an / Anteil neu / Durchlauf / Im Takt}\cell\pard\intbl{solange eine Taste gehalten wird, wird das Gespielte (mit Effekten und Hall) nach jedem Durchlauf zur neuen Grain-Quelle - der Klang entwickelt sich, je l\'e4nger man h\'e4lt. Jeder neue Anschlag beginnt wieder beim Original. Durchlauf: L\'e4nge frei (0,25-8 s) oder im Takt (1/4 bis 2 Takte). Anteil neu: 100 % ersetzt jedes Mal ganz, wenig mischt behutsam bei. Die Tonh\'f6he bleibt stehen (die gespielte Taste wird verrechnet), Pegel und Bass werden ausgeglichen, die Schleife ist nahtlos \'fcberblendet.}\cell\pard\intbl{\cf4 ja (Resampling, Resampling Anteil, Resampling Tempo, Resampling Sync)}\cell\row
\pard\par
{\cf3\b\fs22 Reiter Osz 1 / Osz 2 / Osz 3\par}
\trowd\trgaph90\trleft0\clcbpat6\cellx2500\clcbpat6\cellx7300\clcbpat6\cellx10200
\pard\intbl{\b \cf2 Regler / Knopf}\cell\pard\intbl{\b Was er bewirkt}\cell\pard\intbl{\b VST-Parameter}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Oszillator an}\cell\pard\intbl{drei gleich aufgebaute Oszillatoren, jeder spielt jede Note mit - einzeln einschaltbar und schichtbar (z.B. zwei verstimmte S\'e4gez\'e4hne + Sub-Sinus).}\cell\pard\intbl{\cf4 ja (Osz an / Osz2 an / Osz3 an)}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Welle}\cell\pard\intbl{Sinus, Dreieck, S\'e4ge, Rechteck, FM (zwei Sinus), Rauschen.}\cell\pard\intbl{\cf4 ja (Osz Welle (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Gezeichnet / Zeichnen ...}\cell\pard\intbl{eigene Welle: Haken an = der Oszillator spielt statt "Welle" die gezeichnete Form. "Zeichnen ..." \'f6ffnet die Zeichenfl\'e4che: eine Periode mit der Maus zeichnen (Rechtsklick = 0), Grundformen (Sinus, Dreieck, S\'e4ge, Rechteck, Puls, Zufall, Umkehren) als Ausgangspunkt, Gl\'e4ttung 0-100 % rundet die Obert\'f6ne ab (100 % = fast Sinus). Gespielt wird bandbegrenzt - keine Spiegelfrequenzen, auch hoch oben; Sync, Unison, H\'fcllkurve und Filter wirken wie gewohnt. Wird mit dem Preset gespeichert.}\cell\pard\intbl{\cf4 ja (Osz Gezeichnet (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 folgt Pitch}\cell\pard\intbl{Haken an = alle drei Oszillatoren folgen dem Grain-Regler Pitch samt seiner Modulation (z.B. freier LFO -> Pitch als Step-Sequencer, Vibrato). Aus (Standard) = Pitch wirkt nur auf die Grains. "Auf Pitch legen" im Fenster der freien Form schaltet ihn mit ein.}\cell\pard\intbl{\cf4 ja (Osz folgen Pitch)}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Wavetable an / Laden ... / Position}\cell\pard\intbl{eine Wavetable-Datei laden (WAV, z.B. aus Serum oder Vital: 2048 Punkte je Frame; auch ein einzelner Zyklus). Bis zu 32 Frames, jeder bandbegrenzt wie die eingebauten Wellen. Haken an = der Oszillator spielt die Wavetable statt "Welle" und Zeichnung. Position f\'e4hrt stufenlos durch die Frames und ist je Note modulierbar (z.B. Mod-H\'fcllkurve oder LFO -> Position = wandernder Klang). Beispiele in Beispieltoene: WT_Saege_zu_Rechteck, WT_Formant_Vokale, WT_FM_Wachsend. Lern-Preset L44.}\cell\pard\intbl{\cf4 ja (Osz Wavetable an, Osz WT-Position (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Sub / Sub-Lage / Rauschen (nur Osz 1)}\cell\pard\intbl{Sub = ein zus\'e4tzlicher Ton eine oder zwei Oktaven unter Oszillator 1 (Sinus oder Rechteck), Rauschen = wei\'dfes Rauschen dazu (Anschlag, Luft, Hats). Beide folgen Tonh\'f6he, H\'fcllkurve, Panorama und Filter von Oszillator 1; Pegel relativ zu dessen Pegel. Lern-Preset L45.}\cell\pard\intbl{\cf4 ja (Sub Pegel, Sub Oktave, Sub Welle, Rauschen Pegel)}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Sync (Obert\'f6ne)}\cell\pard\intbl{Hard Sync: 0 = saubere Welle, h\'f6her = immer mehr Obert\'f6ne, schneidend (nicht bei Rauschen).}\cell\pard\intbl{\cf4 ja (Osz Sync (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Oktave / Feinstimmung / Pegel / Panorama}\cell\pard\intbl{Tonlage, Feinabstimmung in Cent, Lautst\'e4rke (bis 200 %) und Position.}\cell\pard\intbl{\cf4 ja (Osz Oktave, Osz Fein, Osz-Pegel, Osz Panorama (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 FM-Verh\'e4ltnis / FM-Menge}\cell\pard\intbl{nur bei Welle FM: Frequenz des Modulators und St\'e4rke - Glocken, E-Piano, Bass.}\cell\pard\intbl{\cf4 ja (Osz FM-Verh., Osz FM-Menge (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 FM-Klangfarbe}\cell\pard\intbl{eigene H\'fcllkurve f\'fcr die FM-Menge (nicht die Lautst\'e4rke): hell im Anschlag, dann weich.}\cell\pard\intbl{\cf4 ja (FM-H\'fcllk. eigen, FM Attack, FM Decay, FM Sustain, FM Release (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Lautst\'e4rke-H\'fcllkurve}\cell\pard\intbl{ADSR des Oszillators, mit Grafik.}\cell\pard\intbl{\cf4 ja (Osz Attack, Osz Decay, Osz Sustain, Osz Release (Osz2, Osz3 entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Eigener Filter}\cell\pard\intbl{Filter nur f\'fcr diesen Oszillator, an Filter 1/2 vorbei (z.B. Rausch-Hats per Hochpass).}\cell\pard\intbl{\cf4 ja (Osz-Filter an, Osz-Filter Typ, Osz-Filter Cutoff, Osz-Filter Resonanz, Osz-Filter Kontur, Osz-Filter H\'fcllk. (Osz2-Filter, Osz3-Filter entsprechend))}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Unison / Verstimmung / Breite}\cell\pard\intbl{2 bis 7 verstimmte Stimmen je Note, im Stereobild verteilt (fette Pads und Leads).}\cell\pard\intbl{\cf4 ja (Osz Unison, Osz Unison Verstimmung, Osz Unison Breite (Osz2, Osz3 entsprechend))}\cell\row
\pard\par
{\cf3\b\fs22 Reiter Filter\par}
\trowd\trgaph90\trleft0\clcbpat6\cellx2500\clcbpat6\cellx7300\clcbpat6\cellx10200
\pard\intbl{\b \cf2 Regler / Knopf}\cell\pard\intbl{\b Was er bewirkt}\cell\pard\intbl{\b VST-Parameter}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Filter an, Typ}\cell\pard\intbl{Tiefpass, Bandpass, Hochpass, Ladder 24 dB (warm angezerrt, steil), Kamm (metallisch, Cutoff = Tonh\'f6he), Formant (Vokale A-E-I-O-U \'fcber den Cutoff).}\cell\pard\intbl{\cf4 ja (Filter an, Filtertyp)}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Cutoff / Resonanz}\cell\pard\intbl{Eckfrequenz und Betonung an der Eckfrequenz.}\cell\pard\intbl{\cf4 ja (Cutoff, Resonanz)}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Kontur}\cell\pard\intbl{wie steil das Filter wirkt (sanft bis scharf).}\cell\pard\intbl{\cf4 ja (Kontur)}\cell\row
