\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 R\'fcckw\'e4rts}\cell\pard\intbl{Anteil der Grains, die r\'fcckw\'e4rts abgespielt werden.}\cell\pard\intbl{\cf4 ja (R\'fcckw\'e4rts)}\cell\row
