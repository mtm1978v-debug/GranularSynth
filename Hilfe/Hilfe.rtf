\pard\intbl{\cf2 Fenster}\cell\pard\intbl{Form, mit der jedes Grain ein- und ausgeblendet wird (weich bis knackig).}\cell\pard\intbl{\cf4 ja (Fenster)}\cell\row
\trowd\trgaph90\trleft0\clcbpat7\cellx2500\clcbpat7\cellx7300\clcbpat7\cellx10200
\pard\intbl{\cf2 Key Tracking}\cell\pard\intbl{an = die Tonh\'f6he folgt der Taste; aus = jede Taste spielt dieselbe Tonh\'f6he (Fl\'e4chen, Ger\'e4usche).}\cell\pard\intbl{\cf4 ja (Key Tracking)}\cell\row
\trowd\trgaph90\trleft0\clcbpat8\cellx2500\clcbpat8\cellx7300\clcbpat8\cellx10200
\pard\intbl{\cf2 Auto-Stimmung}\cell\pard\intbl{erkennt beim Laden den Grundton eines Samples (z.B. \'84C3 +31 Cent\'93) und stimmt es so, dass die Taste C4 wirklich ein C spielt. Wirkt nur bei einem klaren Einzelton (Fl\'f6te, Klavier-Ton, Cello ...), nicht bei Akkorden, Sprache oder Ger\'e4uschen; braucht Key Tracking. Kommt die Tonh\'f6he per Auto-Pitch vom Sidechain, hat diese Vorrang.}\cell\pard\intbl{\cf4 ja (Auto-Stimmung)}\cell\row
